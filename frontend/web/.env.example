# NextAuth
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Backend (server-to-server) and browser-facing API base
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# EdDSA access-token keypair (ADR-0004). The frontend MINTS with the private
# key and PUBLISHES the public key at /api/auth/jwks. Generate with the
# generateAccessKeyPair() helper in @vendme/auth. PEM newlines as \n.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
