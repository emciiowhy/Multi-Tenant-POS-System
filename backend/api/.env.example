NODE_ENV=development
PORT=4000

# Neon Postgres. The pooled URL is used at runtime; the unpooled/direct URL is
# used for migrations and DDL (RLS policy creation).
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:pass@host-direct/db?sslmode=require

REDIS_URL=redis://localhost:6379

# LOCAL QA ONLY. Set to "true" to disable the Stripe subscription paywall so the
# dashboard can be tested without an active subscription. Leave unset (or any
# value other than "true") to keep the paywall ON. MUST be unset for the capstone
# defense / any real deployment. Restart the API after changing.
# QA_BYPASS_BILLING=true

# Token verification (ADR-0004). Prefer the JWKS endpoint published by the
# Next.js auth layer; JWT_PUBLIC_KEY is a single-key fallback for local dev.
JWKS_URL=http://localhost:3000/api/auth/jwks
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

WEB_ORIGIN=http://localhost:3000

# Billing / Stripe (ADR-0005). Optional: the gate + trial work without these;
# the Stripe billing routes (checkout/portal/webhook) only function once set.
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_STANDARD=price_xxx
# Checkout/portal redirect URLs (default to WEB_ORIGIN/billing?... when unset).
# BILLING_SUCCESS_URL=http://localhost:3000/billing?status=success
# BILLING_CANCEL_URL=http://localhost:3000/billing?status=canceled
# BILLING_PORTAL_RETURN_URL=http://localhost:3000/billing
