{
  "name": "vendme",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @vendme/frontend-web dev",
    "dev:api": "pnpm --filter @vendme/backend-api dev",
    "build:web": "pnpm --filter @vendme/frontend-web build",
    "build:api": "pnpm --filter @vendme/backend-api build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @vendme/db generate",
    "db:migrate": "pnpm --filter @vendme/db migrate",
    "db:seed": "pnpm --filter @vendme/backend-api seed",
    "db:push": "pnpm --filter @vendme/db push"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "@types/node": "^22.10.5",
    "prettier": "^3.4.2",
    "@electric-sql/pglite": "^0.4.6",
    "@electric-sql/pglite-socket": "^0.1.6"
  }
}
